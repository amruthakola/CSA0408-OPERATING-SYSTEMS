#include <stdio.h>

struct emp
{
    int id;
    char name[20];
};

int main()
{
    FILE *fp;
    struct emp e;
    int n;

    fp=fopen("emp.dat","wb");

    printf("Enter ID and Name: ");
    scanf("%d%s",&e.id,e.name);

    fwrite(&e,sizeof(e),1,fp);
    fclose(fp);

    fp=fopen("emp.dat","rb");

    printf("Enter record number: ");
    scanf("%d",&n);

    fseek(fp,(n-1)*sizeof(e),SEEK_SET);

    if(fread(&e,sizeof(e),1,fp))
        printf("ID=%d Name=%s",e.id,e.name);

    fclose(fp);
    return 0;
}
