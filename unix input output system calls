#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int fd;
    char data[50];

    fd=open("file.txt",O_CREAT|O_RDWR,0666);

    write(fd,"Operating System",16);

    lseek(fd,0,SEEK_SET);

    read(fd,data,16);

    data[16]='\0';

    printf("%s",data);

    close(fd);

    return 0;
}
