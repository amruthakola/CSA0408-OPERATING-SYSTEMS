#include <stdio.h>

int main()
{
    int n,p[10],bt[10],pr[10],wt[10],tat[10];
    int i,j,t;
    float aw=0,at=0;

    printf("Enter number of processes: ");
    scanf("%d",&n);

    for(i=0;i<n;i++)
    {
        p[i]=i+1;
        printf("BT and Priority of P%d: ",i+1);
        scanf("%d%d",&bt[i],&pr[i]);
    }

    for(i=0;i<n;i++)
        for(j=i+1;j<n;j++)
            if(pr[i]>pr[j])
            {
                t=pr[i]; pr[i]=pr[j]; pr[j]=t;
                t=bt[i]; bt[i]=bt[j]; bt[j]=t;
                t=p[i]; p[i]=p[j]; p[j]=t;
            }

    wt[0]=0;

    for(i=1;i<n;i++)
        wt[i]=wt[i-1]+bt[i-1];

    printf("\nP\tBT\tPR\tWT\tTAT\n");

    for(i=0;i<n;i++)
    {
        tat[i]=wt[i]+bt[i];
        aw+=wt[i];
        at+=tat[i];

        printf("P%d\t%d\t%d\t%d\t%d\n",
               p[i],bt[i],pr[i],wt[i],tat[i]);
    }

    printf("Average WT = %.2f\n",aw/n);
    printf("Average TAT = %.2f",at/n);

    return 0;
}
