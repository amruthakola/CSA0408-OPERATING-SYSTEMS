#include <stdio.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/msg.h>

struct msg
{
    long type;
    char text[100];
};

int main()
{
    int id;
    struct msg m;

    id = msgget(1234,IPC_CREAT|0666);

    m.type=1;
    strcpy(m.text,"Hello Message Queue");

    msgsnd(id,&m,sizeof(m.text),0);
    printf("Sent: %s\n",m.text);

    msgrcv(id,&m,sizeof(m.text),1,0);
    printf("Received: %s\n",m.text);

    msgctl(id,IPC_RMID,NULL);

    return 0;
}
