#include <stdio.h>

int mutex=1,full=0,empty=5,item=0;

void producer()
{
    --mutex;
    ++full;
    --empty;
    item++;

    printf("Produced item %d\n",item);

    ++mutex;
}

void consumer()
{
    --mutex;
    --full;
    ++empty;

    printf("Consumed item %d\n",item);
    item--;

    ++mutex;
}

int main()
{
    int ch;

    while(1)
    {
        printf("\n1. Producer");
        printf("\n2. Consumer");
        printf("\n3. Exit");
        printf("\nEnter choice: ");
        scanf("%d",&ch);

        if(ch==1)
        {
            if(mutex==1 && empty!=0)
                producer();
            else
                printf("Buffer Full");
        }
        else if(ch==2)
        {
            if(mutex==1 && full!=0)
                consumer();
            else
                printf("Buffer Empty");
        }
        else
            break;
    }

    return 0;
}
