#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>

sem_t chop[5];

void *philosopher(void *arg)
{
    int i=*(int*)arg;

    printf("P%d is thinking\n",i);

    sem_wait(&chop[i]);
    sem_wait(&chop[(i+1)%5]);

    printf("P%d is eating\n",i);
    sleep(1);

    sem_post(&chop[(i+1)%5]);
    sem_post(&chop[i]);

    return NULL;
}

int main()
{
    pthread_t t[5];
    int i,id[5];

    for(i=0;i<5;i++)
        sem_init(&chop[i],0,1);

    for(i=0;i<5;i++)
    {
        id[i]=i;
        pthread_create(&t[i],NULL,philosopher,&id[i]);
    }

    for(i=0;i<5;i++)
        pthread_join(t[i],NULL);

    return 0;
}
