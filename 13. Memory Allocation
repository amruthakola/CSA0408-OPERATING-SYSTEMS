#include <stdio.h>

int main()
{
    int b[10],p[10],i,j;

    printf("Enter number of blocks: ");
    scanf("%d",&i);

    printf("Enter block sizes:\n");
    for(j=0;j<i;j++)
        scanf("%d",&b[j]);

    printf("Enter process size: ");
    scanf("%d",&p[0]);

    for(j=0;j<i;j++)
    {
        if(b[j]>=p[0])
        {
            printf("Process allocated to Block %d",j+1);
            return 0;
        }
    }

    printf("Not allocated");
    return 0;
}
